instance_type    = "xxxxxxx"
desired_capacity = x
max_size         = x
min_size         = x

docdb_instance_class = "xxxx"
docdb_instance_count = x

docdb_username = "xxxx"
docdb_password = "xxxx"

db_name = "xxx"

fill in the values above with your own desired values